# Root-only config for the encrypted enrollment volume (ADR-0009 §6, Option C).
#
# Install to /etc/doorboard/enrollment-unlock.env, owner root, mode 0600.
# This file is read by scripts/create-enrollment-volume and
# scripts/doorboard-enrollment-unlock (both run as root).
#
# It holds the NARROW release token and where to fetch from — it never holds
# the LUKS passphrase itself. The passphrase lives only on the NUC
# (CONTROL_PLANE_ENROLLMENT_KEY) and is fetched into RAM at boot.

# NUC control-plane key-release endpoint.
ENROLLMENT_KEY_URL=http://192.168.180.88:8090/status/keys/enrollment

# Path to the release token file (root-only, mode 0600). Its contents must
# equal CONTROL_PLANE_ENROLLMENT_KEY_TOKEN from the NUC .env. Install with:
#   install -m600 -o root -g root /dev/stdin /etc/doorboard/enrollment-key.token <<<'<token>'
ENROLLMENT_KEY_TOKEN_FILE=/etc/doorboard/enrollment-key.token

# LUKS container on the SSD and where it mounts. VISIOND_ENROLLMENT_ROOT in
# doorboard.env must point at ${ENROLLMENT_MOUNT}/${ENROLLMENT_DATA_SUBDIR}.
ENROLLMENT_CONTAINER=/mnt/ssd/doorboard/enrollment.luks
ENROLLMENT_MAPPER=vision-enrollment
ENROLLMENT_MOUNT=/mnt/vision-enrollment
ENROLLMENT_DATA_SUBDIR=doorboard
ENROLLMENT_SIZE_MB=256

# Owner of the enrollment data directory — the account door-visiond runs as.
# Repo-canonical units use doorboard:doorboard; the live door Pi runs visiond
# as tigerstrake — set this to match your deployment.
ENROLLMENT_OWNER=doorboard:doorboard
