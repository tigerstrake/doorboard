#!/usr/bin/env bash
#
# Install the door-Pi systemd units for a repo-in-home deployment.
#
# The units in infra/systemd/ describe the intended production layout: a
# `doorboard` system user, the repo at /opt/doorboard, one virtualenv at
# .venv, and configuration in /etc/doorboard/doorboard.env. The door Pi has
# never been built that way -- it runs from a login user's home with two
# virtualenvs and the .env inside the working tree -- so `install-systemd`
# cannot be used there and nothing was installed at all: every service ran as a
# process orphaned from an SSH session, none survived a reboot, and door-api's
# stdout went to a closed socket so its logs were discarded outright.
#
# This script installs the same canonical units and layers a drop-in per unit
# that redirects user, paths and virtualenv at the real deployment. The canonical
# files stay the single description of the service; the drop-ins carry only what
# differs, so a change to ordering or hardening still applies here.
#
# Migrating the Pi to /opt is the better end state and this does not replace it.
# It stops the door from depending on shell sessions in the meantime.
#
# Usage: sudo bash deploy/pi-door/install-home-layout [repo-root] [run-user]
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "run as root: sudo bash deploy/pi-door/install-home-layout [repo-root] [run-user]" >&2
  exit 1
fi

run_user="${2:-${SUDO_USER:-}}"
if [[ -z "$run_user" ]]; then
  echo "cannot determine the run user; pass it as the second argument" >&2
  exit 1
fi
run_home="$(getent passwd "$run_user" | cut -d: -f6)"
repo="${1:-$run_home/doorboard}"
env_file="$repo/.env"
venv="$run_home/.venvs/doorboard"
visiond_venv="$run_home/.venvs/doorboard-visiond"

for path in "$repo/infra/systemd" "$env_file" "$venv/bin/python" "$visiond_venv/bin/python"; do
  if [[ ! -e "$path" ]]; then
    echo "missing $path -- is this the right repo root and user?" >&2
    exit 1
  fi
done

# The door talks to the controller over a tty and reads the camera; without these
# the services start and then fail in ways that look like application bugs.
for group in dialout video render; do
  if ! id -nG "$run_user" | tr ' ' '\n' | grep -qx "$group"; then
    echo "warning: $run_user is not in the '$group' group" >&2
  fi
done

install -m 0644 "$repo"/infra/systemd/*.service /etc/systemd/system/
install -m 0644 "$repo"/infra/systemd/*.timer /etc/systemd/system/

# ---------------------------------------------------------------------------
# Drop-ins
# ---------------------------------------------------------------------------
#
# `.env` is sourced by bash rather than handed to EnvironmentFile, because
# systemd does NOT treat a trailing `# comment` as a comment -- it keeps it in
# the value. Verified on this Pi: `FOO=bar   # trailing comment` arrives as
# `bar   # trailing comment`. The live .env documents most of its settings that
# way, so as an EnvironmentFile it would set ESP32_TRANSPORT to
# "uart             # uart | udp | mock" (silently disabling the controller link)
# and make door-api die on int("4096 # bounded durable queue ..."). Sourcing also
# keeps one source of truth instead of a generated copy that can drift.

write_dropin() {
  local unit="$1" body="$2"
  install -d -m 0755 "/etc/systemd/system/${unit}.d"
  cat > "/etc/systemd/system/${unit}.d/home-layout.conf" <<EOF
# Generated by deploy/pi-door/install-home-layout. Do not edit in place;
# edit the script and re-run it, or the next install silently reverts you.
[Service]
User=$run_user
Group=$run_user
WorkingDirectory=$repo
# ProtectSystem=strict would otherwise make the repo read-only, and some
# processes write beside it (door-visiond drops hailort.log in its cwd).
ProtectHome=no
ReadWritePaths=$repo
# So journald receives log lines as they happen rather than per 8 KB block.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=
$body
EOF
}

python_service() {
  local unit="$1" service_venv="$2" module="$3"
  write_dropin "$unit" "ExecStart=
ExecStart=/bin/bash -c 'set -a; . $env_file; set +a; exec $service_venv/bin/python -m $module'"
}

python_service door-api.service "$venv" door_api
python_service door-media.service "$venv" door_media
python_service door-sync.service "$venv" door_sync
python_service door-visiond.service "$visiond_venv" door_visiond

write_dropin doorboard-storage-ready.service "ExecStart=
ExecStart=/bin/bash -c 'set -a; . $env_file; set +a; exec $venv/bin/python $repo/scripts/check-door-storage'"

# Binds 0.0.0.0, unlike the canonical unit's 127.0.0.1: the dev server this
# replaces was started with --host 0.0.0.0, and narrowing it would quietly cut
# off anything opening the door UI from another machine on the LAN.
write_dropin door-ui.service "ExecStart=
ExecStart=$venv/bin/python $repo/scripts/serve_door_ui.py --directory $repo/apps/door-ui/dist --host 0.0.0.0 --port 5173"

# This Pi's mediamtx config lives on the SSD next to its recordings, not in /etc.
mediamtx_config=/mnt/ssd/doorboard/mediamtx/mediamtx.yml
write_dropin mediamtx.service "ExecStart=
ExecStart=/usr/local/bin/mediamtx $mediamtx_config"

# Stays root so it can restart a hung unit, so no User override here.
install -d -m 0755 "/etc/systemd/system/doorboard-health-agent.service.d"
cat > "/etc/systemd/system/doorboard-health-agent.service.d/home-layout.conf" <<EOF
# Generated by deploy/pi-door/install-home-layout.
[Service]
ProtectHome=no
ReadWritePaths=$repo
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=
# The agent keeps its failure counters under /run/doorboard, which nothing else
# creates; RuntimeDirectory makes systemd create and clean it up.
RuntimeDirectory=doorboard
ExecStart=
ExecStart=$venv/bin/python $repo/scripts/doorboard-health-agent
EOF

systemctl daemon-reload
systemctl enable \
  doorboard-storage-ready.service \
  mediamtx.service \
  door-ui.service \
  door-media.service \
  door-visiond.service \
  door-api.service \
  door-sync.service \
  doorboard-health-agent.timer

cat <<'EOF'
Units installed and enabled, but NOT started -- anything already running as an
ad-hoc process still owns its port.

Migrate one service at a time, checking health between each:

  pkill -f 'door_sync'   && systemctl start door-sync    && curl -s localhost:8083/health
  pkill -f 'door_media'  && systemctl start door-media   && curl -s localhost:8082/health
  pkill -f 'door_api'    && systemctl start door-api     && curl -s localhost:8080/health
  pkill -f 'door_visiond'&& systemctl start door-visiond && curl -s localhost:8081/health

door-ui serves a built bundle, so build it before starting that unit:

  pnpm --filter @doorboard/door-ui build
EOF
