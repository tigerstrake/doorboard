#!/usr/bin/env bash
#
# Install the door-Pi systemd units for a repo-in-home deployment.
#
# The units in infra/systemd/ describe the intended production layout: a
# `doorboard` system user, the repo at /opt/doorboard, one virtualenv at .venv,
# and configuration in /etc/doorboard/doorboard.env. The door Pi has never been
# built that way -- it runs from a login user's home with two virtualenvs and the
# .env inside the working tree -- so `install-systemd` refuses it outright.
#
# It had been adapted by hand on the Pi instead: units existed and ran everything
# except door-visiond, but only on that machine's disk, with no record here of
# what they contained. Reinstalling from the repo therefore meant *replacing* a
# working configuration nobody could review. This script exists so the adaptation
# is written down: the canonical units stay the single description of each
# service, and one drop-in per unit carries only what differs -- user, paths,
# virtualenv, config source -- so changes to ordering or hardening still apply
# here.
#
# Migrating the Pi to /opt is the better end state and this does not replace it.
# It makes the current deployment reproducible in the meantime.
#
# Usage: sudo bash deploy/pi-door/install-home-layout [repo-root] [run-user]
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "run as root: sudo bash deploy/pi-door/install-home-layout [repo-root] [run-user]" >&2
  exit 1
fi

run_user="${2:-${SUDO_USER:-}}"
if [[ -z "$run_user" ]]; then
  echo "cannot determine the run user; pass it as the second argument" >&2
  exit 1
fi
run_home="$(getent passwd "$run_user" | cut -d: -f6)"
repo="${1:-$run_home/doorboard}"
env_file="$repo/.env"
venv="$run_home/.venvs/doorboard"
visiond_venv="$run_home/.venvs/doorboard-visiond"

for path in "$repo/infra/systemd" "$env_file" "$venv/bin/python" "$visiond_venv/bin/python"; do
  if [[ ! -e "$path" ]]; then
    echo "missing $path -- is this the right repo root and user?" >&2
    exit 1
  fi
done

# The door talks to the controller over a tty and reads the camera; without these
# the services start and then fail in ways that look like application bugs.
for group in dialout video render; do
  if ! id -nG "$run_user" | tr ' ' '\n' | grep -qx "$group"; then
    echo "warning: $run_user is not in the '$group' group" >&2
  fi
done

# Same class of failure, in configuration (T-311): the greeting path is gated on a
# shared token, and an existing .env predating it has no such line. Unset, door-api
# closes POST /internal/events with 503 and door-visiond reports
# `event_forwarding: disabled` -- a recognised face gets the door light and a silent
# screen, which looks exactly like recognition not working.
event_token="$(sed -n 's/^[[:space:]]*DOOR_API_INTERNAL_EVENT_TOKEN=//p' "$env_file" | head -1)"
event_token="${event_token%%#*}"
event_token="$(tr -d '[:space:]"'"'" <<<"$event_token")"
if [[ -z "$event_token" || "$event_token" == CHANGE_ME ]]; then
  echo "warning: DOOR_API_INTERNAL_EVENT_TOKEN is unset in $env_file;" >&2
  echo "         recognition will work and the wallboard greeting will not fire" >&2
fi

install -m 0644 "$repo"/infra/systemd/*.service /etc/systemd/system/
install -m 0644 "$repo"/infra/systemd/*.timer /etc/systemd/system/

# The Pi's only LAN listener (ADR-0047): Caddy on :80 forwarding the allow-list
# in deploy/pi-door/Caddyfile. The Debian package enables its own caddy.service
# with a placeholder site on :80; that one must not hold the port.
if ! command -v caddy >/dev/null 2>&1; then
  echo "warning: caddy is not installed (apt install caddy); door-proxy.service will fail to start" >&2
fi
install -d -m 0755 /etc/doorboard
install -m 0644 "$repo"/deploy/pi-door/Caddyfile /etc/doorboard/Caddyfile
if systemctl list-unit-files caddy.service >/dev/null 2>&1; then
  systemctl disable --now caddy.service 2>/dev/null || true
fi
# Host metrics for Prometheus (infra/monitoring): the package's own unit listens
# on 0.0.0.0:9100, which ADR-0047 forbids; infra/systemd/node-exporter.service
# runs the same binary on loopback behind the proxy's /metrics/node. Skipped
# cleanly when `apt install prometheus-node-exporter` has not been done.
if systemctl list-unit-files prometheus-node-exporter.service >/dev/null 2>&1; then
  systemctl disable --now prometheus-node-exporter.service 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Drop-ins
# ---------------------------------------------------------------------------
#
# `.env` is NOT handed to EnvironmentFile= directly: systemd does not treat a
# trailing `# comment` as a comment -- it keeps it in the value. Verified on
# this Pi: `FOO=bar   # trailing comment` arrives as `bar   # trailing comment`,
# so ESP32_TRANSPORT would become "uart   # uart | udp | mock" and silently
# disable the controller link. It is not bash-sourced either (the previous
# answer): sourced, every value is a shell expression -- a species list with a
# space is a command, `Hi {name}` a brace expansion, `&FORMAT=tle` a forked
# job, `$(...)` executes, all as the service user and all silently. Instead
# deploy/pi-door/render-systemd-env writes a systemd-safe copy (trailing
# comments stripped, nothing evaluated) that the units read via
# EnvironmentFile=. `.env` stays the file you edit; re-run this script (or the
# renderer alone) after changing it, or the units keep the old values.
rendered_env=/etc/doorboard/doorboard-home.env
python3 "$repo/deploy/pi-door/render-systemd-env" "$env_file" "$rendered_env"
chown root:"$run_user" "$rendered_env"
chmod 0640 "$rendered_env"

write_dropin() {
  local unit="$1" body="$2"
  install -d -m 0755 "/etc/systemd/system/${unit}.d"
  cat > "/etc/systemd/system/${unit}.d/home-layout.conf" <<EOF
# Generated by deploy/pi-door/install-home-layout. Do not edit in place;
# edit the script and re-run it, or the next install silently reverts you.
[Unit]
# This Pi's RTC does not hold time and fake-hwclock is not installed, so the
# kernel starts the clock at 1970-01-01 and timesyncd jumps it seconds later.
# Anything stamping UTC in that window records a nonsense time -- log lines from
# one startup came out 9 hours apart depending on who stamped them.
#
# Ordering only, deliberately weak: time-sync.target is reached when timesyncd
# STARTS, not when the clock is correct. The unit that actually waits,
# systemd-time-wait-sync, is left disabled on purpose -- it would block the door
# services until NTP answered, and the door must come up with the network down
# (ARCHITECTURE.md §10). The real fix is a coin cell on the Pi 5 RTC header, or
# fake-hwclock; this just stops us starting before the clock is even trying.
After=time-sync.target
Wants=time-sync.target
[Service]
User=$run_user
Group=$run_user
WorkingDirectory=$repo
# ProtectSystem=strict would otherwise make the repo read-only, and some
# processes write beside it (door-visiond drops hailort.log in its cwd).
ProtectHome=no
ReadWritePaths=$repo
# So journald receives log lines as they happen rather than per 8 KB block.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=
$body
EOF
}

python_service() {
  local unit="$1" service_venv="$2" module="$3"
  write_dropin "$unit" "EnvironmentFile=$rendered_env
ExecStart=
ExecStart=$service_venv/bin/python -m $module"
}

python_service door-api.service "$venv" door_api
python_service door-media.service "$venv" door_media
python_service door-sync.service "$venv" door_sync
python_service door-voice.service "$venv" door_voice
python_service door-visiond.service "$visiond_venv" door_visiond

write_dropin doorboard-storage-ready.service "EnvironmentFile=$rendered_env
ExecStart=
ExecStart=$venv/bin/python $repo/scripts/check-door-storage"

# The built bundle on loopback, as the canonical unit does -- not the Vite dev
# server on 0.0.0.0 this Pi used to run. That server published /admin, /ws,
# /session and, through /@fs/, the whole checkout to the corridor; ADR-0047 makes
# door-proxy.service the only LAN listener and the kiosks keep loading
# http://127.0.0.1:5173/... exactly as before. The bundle is a build step on
# every deploy: `pnpm --filter @doorboard/door-ui build` (see the check below).
if [[ ! -f "$repo/apps/door-ui/dist/index.html" ]]; then
  echo "missing $repo/apps/door-ui/dist/index.html -- build the kiosk bundle first:" >&2
  echo "  VITE_AMBIENT_MOCK=false pnpm --filter @doorboard/door-ui build" >&2
  exit 1
fi
write_dropin door-ui.service "ExecStart=
ExecStart=$venv/bin/python $repo/scripts/serve_door_ui.py --directory $repo/apps/door-ui/dist --host 127.0.0.1 --port 5173"

# This Pi's mediamtx config lives on the SSD next to its recordings, not in /etc.
mediamtx_config=/mnt/ssd/doorboard/mediamtx/mediamtx.yml
write_dropin mediamtx.service "ExecStart=
ExecStart=/usr/local/bin/mediamtx $mediamtx_config"

# The two units that run as root (the LUKS unlock: cryptsetup + mount; the
# health agent: it restarts units) execute a root-owned copy of their script
# from /usr/local/lib/doorboard, with the system python3 -- never a file in
# this checkout or an interpreter in $HOME, both of which the run user (and
# so anything that compromises a door service) can write. The canonical units
# already point there, so neither needs a drop-in in this layout. Earlier
# installs wrote drop-ins that pointed root back into the checkout; remove
# them, or they keep winning.
#
# The unlock is the unit that once cost a reboot's worth of recognition: an
# install replaced the Pi's hand-adapted copy, nothing re-pointed it, and at
# the next boot the LUKS volume never unlocked. Hence the audit at the end.
install -d -m 0755 -o root -g root /usr/local/lib/doorboard
install -m 0755 -o root -g root "$repo/scripts/doorboard-enrollment-unlock" /usr/local/lib/doorboard/
install -m 0755 -o root -g root "$repo/scripts/doorboard-health-agent" /usr/local/lib/doorboard/
rm -f /etc/systemd/system/doorboard-enrollment-unlock.service.d/home-layout.conf \
      /etc/systemd/system/doorboard-health-agent.service.d/home-layout.conf

systemctl daemon-reload
systemctl enable \
  doorboard-storage-ready.service \
  mediamtx.service \
  door-ui.service \
  door-media.service \
  door-visiond.service \
  door-api.service \
  door-sync.service \
  door-voice.service \
  door-proxy.service \
  node-exporter.service \
  doorboard-enrollment-unlock.service \
  doorboard-enrollment-unlock.timer \
  doorboard-health-agent.timer

# ---------------------------------------------------------------------------
# Audit: no managed unit may still point into /opt/doorboard
# ---------------------------------------------------------------------------
#
# This script copies every file in infra/systemd/, so it replaces units it has no
# drop-in for. That happened once: doorboard-enrollment-unlock kept the canonical
# ExecStart, the LUKS volume did not unlock at the next boot, and recognition was
# down until someone read a journal. A missing drop-in is invisible until a reboot,
# so check the effective configuration now rather than trusting the list above.
managed_units=(
  doorboard-storage-ready.service
  doorboard-enrollment-unlock.service
  doorboard-health-agent.service
  mediamtx.service
  door-ui.service
  door-media.service
  door-visiond.service
  door-api.service
  door-sync.service
  door-voice.service
  door-proxy.service
)
stale=()
for unit in "${managed_units[@]}"; do
  for property in ExecStart ExecStop WorkingDirectory; do
    if systemctl show "$unit" -p "$property" --value 2>/dev/null | grep -q /opt/doorboard; then
      stale+=("$unit ($property)")
    fi
  done
done
if (( ${#stale[@]} )); then
  echo >&2
  echo "ERROR: these units still resolve to /opt/doorboard, which does not exist here:" >&2
  printf '  %s\n' "${stale[@]}" >&2
  echo "Add a drop-in for each in $0 and re-run. Until then they will fail at boot." >&2
  exit 1
fi
echo "Audit passed: no managed unit resolves to /opt/doorboard."

cat <<'EOF'
Units installed and enabled. Nothing was started or restarted: a unit that is
already active keeps running its previous ExecStart until you restart it, and a
service still running outside systemd keeps owning its port.

Adopt them one at a time, checking health in between (`systemctl restart` for one
already active, `start` for one that is dead):

  systemctl restart door-sync    && curl -s localhost:8083/health
  systemctl restart door-media   && curl -s localhost:8082/health
  systemctl restart door-api     && curl -s localhost:8080/health
  systemctl restart door-ui      && curl -sI localhost:5173/ | head -1
  systemctl start   door-proxy   && curl -s -o /dev/null -w '%{http_code}\n' localhost/session   # 404
  systemctl start   door-visiond && curl -s localhost:8081/health
  systemctl start   door-voice   && curl -s localhost:8084/health   # only if FEATURE_VOICE_GREETING
  systemctl start   doorboard-enrollment-unlock.timer doorboard-health-agent.timer

The kiosks are launched by the Wayland session, not by these units: install
deploy/pi-door/labwc-autostart.example as ~/.config/labwc/autostart so they
wait for door-api's /health and relaunch on exit.

Anything left running outside systemd must be stopped first, or the unit will
fail to bind. Find it by port rather than by name:

  ss -ltnp | grep :8081
EOF
