# Install as /etc/doorboard/kiosk-doorpad.env (read by chromium-kiosk@doorpad).
KIOSK_URL=http://127.0.0.1:5173/doorpad
# Wayland session the kiosk joins. The unit defaults to wayland-0 and
# /run/user/1000; set these when the kiosk user's uid or labwc's socket differ.
# WAYLAND_DISPLAY=wayland-0
# XDG_RUNTIME_DIR=/run/user/1000
