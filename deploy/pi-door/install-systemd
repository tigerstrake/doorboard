#!/usr/bin/env bash
set -euo pipefail

repo_root="${1:-/opt/doorboard}"
env_file=/etc/doorboard/doorboard.env

if [[ $EUID -ne 0 ]]; then
  echo "run as root: sudo bash deploy/pi-door/install-systemd [repo-root]" >&2
  exit 1
fi
if [[ ! -f "$env_file" ]]; then
  echo "missing $env_file; install deploy/pi-door/doorboard.env.example first" >&2
  exit 1
fi
if [[ ! -d "$repo_root/infra/systemd" ]]; then
  echo "invalid repo root: $repo_root" >&2
  exit 1
fi

required_secrets=(
  DOOR_API_VISITOR_TOKEN_SECRET
  DOOR_API_SOCIAL_ADMIN_TOKEN
  DOOR_VISIOND_ADMIN_TOKEN
  DOOR_MEDIA_ADMIN_TOKEN
  DOOR_SYNC_ADMIN_TOKEN
  SYNC_INGEST_TOKEN
)
for key in "${required_secrets[@]}"; do
  value="$(awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$env_file")"
  if [[ -z "$value" || "$value" == CHANGE_ME* ]]; then
    echo "$env_file: set a non-placeholder value for $key before installation" >&2
    exit 1
  fi
done

install -d -m 0755 /etc/doorboard /var/lib/doorboard
install -m 0644 "$repo_root"/infra/systemd/*.service /etc/systemd/system/
install -m 0644 "$repo_root"/infra/systemd/*.timer /etc/systemd/system/

# The two scripts root runs (LUKS unlock, health agent) execute from a
# root-owned copy, never from the checkout: a writable script run as root is
# a privilege escalation for anything that compromises a door service.
install -d -m 0755 -o root -g root /usr/local/lib/doorboard
install -m 0755 -o root -g root "$repo_root"/scripts/doorboard-enrollment-unlock /usr/local/lib/doorboard/
install -m 0755 -o root -g root "$repo_root"/scripts/doorboard-health-agent /usr/local/lib/doorboard/

# The Pi's only LAN listener (ADR-0047): Caddy on :80 forwarding the allow-list
# in deploy/pi-door/Caddyfile. The Debian package enables its own caddy.service
# with a placeholder site on :80; that one must not hold the port.
if ! command -v caddy >/dev/null 2>&1; then
  echo "caddy is not installed (apt install caddy); door-proxy.service will fail to start" >&2
fi
install -m 0644 "$repo_root"/deploy/pi-door/Caddyfile /etc/doorboard/Caddyfile
if systemctl list-unit-files caddy.service >/dev/null 2>&1; then
  systemctl disable --now caddy.service 2>/dev/null || true
fi
# Host metrics for Prometheus (infra/monitoring): the package's own unit listens
# on 0.0.0.0:9100, which ADR-0047 forbids; infra/systemd/node-exporter.service
# runs the same binary on loopback behind the proxy's /metrics/node. Skipped
# cleanly when `apt install prometheus-node-exporter` has not been done.
if systemctl list-unit-files prometheus-node-exporter.service >/dev/null 2>&1; then
  systemctl disable --now prometheus-node-exporter.service 2>/dev/null || true
fi
chown root:doorboard "$env_file"
chmod 0640 "$env_file"

systemctl daemon-reload
systemctl enable \
  doorboard-storage-ready.service \
  mediamtx.service \
  door-ui.service \
  door-media.service \
  door-visiond.service \
  door-api.service \
  door-sync.service \
  door-voice.service \
  door-proxy.service \
  node-exporter.service \
  doorboard-enrollment-unlock.service \
  doorboard-enrollment-unlock.timer \
  doorboard-health-agent.timer

echo "Units installed. Start with: systemctl start door-ui door-api door-sync doorboard-health-agent.timer"
