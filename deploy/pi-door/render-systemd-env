#!/usr/bin/env python3
"""Render a dotenv-style file into one systemd's ``EnvironmentFile=`` reads verbatim.

Usage: render-systemd-env SRC DEST

The Pi's ``.env`` documents most settings with a trailing ``# comment`` on the same
line. systemd does not treat that as a comment: ``ESP32_TRANSPORT=uart  # uart | udp``
arrives as ``uart  # uart | udp`` and silently disables the controller link.
``install-home-layout`` used to work around that by bash-sourcing the file inside
``ExecStart=/bin/bash -c 'set -a; . .env; ...'`` — which made every value a shell
expression: a species list with a space became a command, ``Hi {name}`` became a
brace expansion, ``?GROUP=stations&FORMAT=tle`` forked a background job and exported
``FORMAT=tle``, and a value containing ``$(...)`` would have executed. Both were
silent.

This step keeps ``.env`` as the single file the operator edits and writes a copy
systemd parses the way the author meant: full-line comments dropped, a trailing
``<whitespace>#...`` stripped from an unquoted value, a fully quoted value kept
quoted (systemd strips the quotes itself), a backslash doubled so systemd's escape
handling returns it, and nothing ever evaluated. ``tests/test_pi_env_render.py``
proves every key in both templates comes out with its literal value.

stdlib only: it runs as root at install time on the Pi, outside any venv.
"""

from __future__ import annotations

import os
import re
import sys
import tempfile
from pathlib import Path

_LINE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
_TRAILING_COMMENT = re.compile(r"\s+#.*$")


def render_value(raw: str) -> str:
    """The value systemd should see for the text after ``=`` in a dotenv line."""
    value = raw.strip()
    if value[:1] in ("'", '"'):
        quote = value[0]
        closing = value.find(quote, 1)
        if closing != -1:
            # Keep the quotes: EnvironmentFile strips them and keeps everything
            # inside, spaces and '#' included. Drop anything after the close.
            return value[: closing + 1]
        # Unbalanced quote: treat as an ordinary value so nothing is lost.
    value = _TRAILING_COMMENT.sub("", value).rstrip()
    # systemd reads `\x` as an escape in an unquoted value; double it so the
    # literal backslash the author wrote survives.
    return value.replace("\\", "\\\\")


def render(source: str) -> list[str]:
    out: list[str] = []
    for line in source.splitlines():
        match = _LINE.match(line)
        if not match:
            continue  # blank, comment, or not an assignment
        key, raw = match.group(1), match.group(2)
        out.append(f"{key}={render_value(raw)}")
    return out


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print("usage: render-systemd-env SRC DEST", file=sys.stderr)
        return 2
    src, dest = Path(argv[1]), Path(argv[2])
    lines = render(src.read_text(encoding="utf-8"))
    header = [
        f"# GENERATED from {src} by deploy/pi-door/render-systemd-env.",
        "# Do not edit: change the source file and re-run",
        "#   sudo bash deploy/pi-door/install-home-layout",
        "# (or just this script). Trailing '# comments' have been stripped so",
        "# systemd's EnvironmentFile= sees the values the source file meant.",
    ]
    body = "\n".join(header + lines) + "\n"
    dest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(body)
        os.chmod(tmp, 0o600)
        os.replace(tmp, dest)
    except BaseException:
        os.unlink(tmp)
        raise
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
