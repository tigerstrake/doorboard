# Door Pi only. Install as /etc/doorboard/doorboard.env, root-owned, mode 0600.
#
# deploy/pi-door/install-systemd hands this file to systemd's EnvironmentFile=, and
# install-home-layout bash-sources it. EnvironmentFile= keeps a trailing `# comment`
# as PART OF THE VALUE ("uart   # uart | udp" silently disables the controller link),
# so every comment here sits on its own line and tests/test_pi_env_template.py refuses
# a trailing one. Keep it that way.
#
# Each service's "tuning" block lists the settings it reads that have a sensible
# default (the value shown is the code default); uncomment a line to change it.
# NUC-only credentials (Home Assistant, Postgres, control-plane admin) never go in
# this file — the door Pi gets limited-scope tokens only (ARCHITECTURE.md §Trust).

DOORBOARD_DOOR_ID=primary
SSD_DATA_ROOT=/mnt/ssd/doorboard

# --- door-api (apps/door-api/src/door_api/config.py) -------------------------
DOOR_API_BIND=127.0.0.1:8080
DOOR_API_MEDIA_BASE_URL=http://127.0.0.1:8082
DOOR_API_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8082
DOOR_API_SYNC_BASE_URL=http://127.0.0.1:8083
DOOR_API_SYNC_OUTBOX_MAX_ROWS=4096
DOOR_API_SYNC_TIMEOUT_S=1
DOOR_API_VISITOR_PUBLIC_BASE_URL=http://door.local
DOOR_API_VISITOR_TOKEN_SECRET=CHANGE_ME
DOOR_API_SOCIAL_ADMIN_TOKEN=CHANGE_ME
# Read by BOTH door-api (which requires it on POST /internal/events) and
# door-visiond (which presents it). Unset means recognised faces never reach the
# screen: door-api closes the route with 503 and the wallboard greeting never fires.
DOOR_API_INTERNAL_EVENT_TOKEN=CHANGE_ME
DOOR_API_BASE_URL=http://127.0.0.1:8080

# Public visitor relay (ADR-0017/ADR-0043, docs/runbooks/visitor-qr.md). The relay is
# live, so a door built from this template needs all three: the QR falls back to the
# LAN-only URL while they are unset. Base URL must be https. The device token is the
# VISITOR pair (RELAY_VISITOR_DEVICE_TOKEN on the relay), NOT the enrollment one.
# Public URL is what the phone loads; normally the same host as the base URL.
# Leave BASE_URL empty on a door that must not reach the internet at all.
DOOR_API_VISITOR_RELAY_BASE_URL=https://CHANGE_ME
DOOR_API_VISITOR_RELAY_DEVICE_TOKEN=CHANGE_ME
DOOR_API_VISITOR_RELAY_PUBLIC_URL=https://CHANGE_ME

# door-api tuning
# session + social SQLite files; default under SSD_DATA_ROOT/door-api/
# DOOR_API_DB_PATH=/mnt/ssd/doorboard/door-api/session.sqlite
# DOOR_API_SOCIAL_DB_PATH=/mnt/ssd/doorboard/door-api/social.sqlite
# ESP32 effect id played on a doorpad tap (must exist in the firmware catalog)
# DOOR_API_DOORPAD_EFFECT_ID=generic_press
# Relay worker pacing: poll interval, per-request timeout, backoff ceiling, and how
# recent a successful exchange must be for the QR to prefer the relay URL over LAN.
# DOOR_API_VISITOR_RELAY_POLL_S=2.0
# DOOR_API_VISITOR_RELAY_TIMEOUT_S=4.0
# DOOR_API_VISITOR_RELAY_BACKOFF_MAX_S=60
# DOOR_API_VISITOR_RELAY_FRESHNESS_S=30
# UDP transport only (ESP32_TRANSPORT=udp); ignored for uart. host:port each.
# ESP32_UDP_LOCAL_ADDR=
# ESP32_UDP_REMOTE_ADDR=
# Legacy spelling of DOORBOARD_DOOR_ID, honoured for one release; do not set both.
# DOOR_API_DOOR_ID=primary

# --- door-visiond (apps/door-visiond/src/door_visiond/settings.py) ---------
DOOR_VISIOND_BIND=127.0.0.1:8081
DOOR_VISIOND_ADMIN_TOKEN=CHANGE_ME
VISION_MODE=single-camera
VISIOND_ENROLLMENT_ROOT=/mnt/vision-enrollment/doorboard
VISIOND_REQUIRE_ENCRYPTED_STORAGE=true
# Relative, as in the root .env.example: door-visiond resolves it against the
# unit's WorkingDirectory, which install-home-layout sets to the repo checkout.
# /opt/doorboard does not exist on the door Pi (that script audits units against
# it); an absolute path there leaves /consent answering 503.
VISIOND_CONSENT_STATEMENT_PATH=docs/policies/consent-statement.md
DOOR_SYNC_BASE_URL=http://127.0.0.1:8083

# Remote (phone) enrollment relay (ADR-0043, docs/runbooks/remote-enrollment-relay.md).
# Same host as the visitor relay above but the ENROLLMENT token pair
# (RELAY_DEVICE_TOKEN on the relay). Unset BASE_URL on a door that should not offer
# phone enrollment: the poller never starts and no sealing key is generated.
VISIOND_RELAY_BASE_URL=https://CHANGE_ME
VISIOND_RELAY_DEVICE_TOKEN=CHANGE_ME
VISIOND_RELAY_PUBLIC_URL=https://CHANGE_ME

# door-visiond tuning
# Recognition: cosine threshold, minimum face size in px, and the stable-identity
# vote (REQUIRED of the last WINDOW frames). Rerun scripts/match-probe after aiming
# the camera before touching the threshold (its header explains what the scores mean).
# VISIOND_MATCH_THRESHOLD=0.62
# VISIOND_MIN_FACE_PX=80
# VISIOND_STABILITY_WINDOW=3
# VISIOND_STABILITY_REQUIRED=2
# VISIOND_MIN_ENROLL_QUALITY=0.5
# How long a recognised identity stays cached, greeting repeat suppression, and the
# camera poll cadence.
# VISIOND_IDENTITY_TTL_MS=2500
# VISIOND_GREETING_COOLDOWN_MS=30000
# VISIOND_FRAME_INTERVAL_MS=100
# Visit log: merge sightings closer than this into one visit; flush cadence.
# VISIOND_VISIT_MERGE_WINDOW_S=600
# VISIOND_VISIT_WRITE_INTERVAL_MS=30000
# Forwarding to door-api and the ESP32 profile relay.
# VISIOND_EVENT_FORWARD_TIMEOUT_S=1.0
# VISIOND_ESP32_PROFILE_RELAY_MIN_INTERVAL_MS=1000
# Deletion purge worker (unenroll fan-out to door-sync) and its retry ceiling.
# DOOR_VISIOND_SYNC_TIMEOUT_S=2.0
# DOOR_VISIOND_PURGE_WORKER_INTERVAL_S=1.0
# DOOR_VISIOND_PURGE_RETRY_MAX_S=300
# Relay poller pacing and invite policy.
# VISIOND_RELAY_POLL_INTERVAL_S=5
# VISIOND_RELAY_IDLE_GRACE_S=300
# VISIOND_RELAY_TIMEOUT_S=5
# VISIOND_RELAY_BACKOFF_MAX_S=300
# VISIOND_RELAY_INVITE_TTL_S=3600
# VISIOND_RELAY_MAX_IMAGES=5
# minimum 900: must outlive the relay's 15-minute ciphertext TTL
# VISIOND_RELAY_RETIRED_KEY_TTL_S=3600
# Model pins (ADR-0009). Changing the model invalidates every stored template, so
# these are asserted at startup rather than tuned; listed so they are discoverable.
# VISIOND_MODEL_ID=arcface_mobilefacenet_v1
# VISIOND_MODEL_DIM=512
# VISIOND_HAILO_RUNTIME_VERSION=4.23.0

# --- door-media (apps/door-media/src/door_media/settings.py) ---------------
DOOR_MEDIA_BIND=127.0.0.1:8082
DOOR_MEDIA_ADMIN_TOKEN=CHANGE_ME
MEDIA_MODE=mediamtx
MEDIAMTX_API=http://127.0.0.1:9997
DOOR_MEDIA_SEGMENT_RETENTION_S=3600
DOOR_MEDIA_SEGMENT_CLEANUP_INTERVAL_S=60
DOOR_MEDIA_MAX_ACTIVE_RECORDINGS=8
DOOR_MEDIA_MIN_FREE_BYTES=4294967296

# door-media tuning
# MediaMTX binary, its generated config, and the version /health asserts.
# MEDIAMTX_BIN=mediamtx
# MEDIAMTX_CONFIG_PATH=/mnt/ssd/doorboard/mediamtx/mediamtx.yml
# MEDIAMTX_VERSION=1.9.3
# Which MediaMTX path carries the visitor camera.
# VISITOR_CAM_STREAM=visitor
# Recording: HLS segment length, age cap for unsynced clips (7 days), and how often
# the storage-status event is broadcast.
# DOOR_MEDIA_SEGMENT_S=2
# DOOR_MEDIA_MAX_CLIP_AGE_S=604800
# DOOR_MEDIA_STORAGE_STATUS_INTERVAL_S=60
# Visitor camera encode and orientation (T-314). Rotation in degrees.
# DOOR_MEDIA_VIDEO_H264_LEVEL=4.2
# DOOR_MEDIA_VIDEO_ROTATION=0
# DOOR_MEDIA_VIDEO_HFLIP=false
# DOOR_MEDIA_VIDEO_VFLIP=false
# Recognition camera orientation (ADR-0023) — the upside-down mount was found here.
# DOOR_MEDIA_RECOGNITION_HFLIP=false
# DOOR_MEDIA_RECOGNITION_VFLIP=false
# Snapshot reader feeding /snapshot/recognition: on/off, fps, staleness bound, idle
# stop, and how long the first frame may take after a cold start.
# DOOR_MEDIA_SNAPSHOT_READER_ENABLED=true
# DOOR_MEDIA_SNAPSHOT_READER_FPS=10
# DOOR_MEDIA_SNAPSHOT_MAX_AGE_S=1.0
# DOOR_MEDIA_SNAPSHOT_READER_IDLE_STOP_S=30
# DOOR_MEDIA_RECOGNITION_FIRST_FRAME_WAIT_S=4.0
# Audio on the visitor stream (off by default; a hallway microphone is a disclosure).
# MEDIA_AUDIO_ENABLED=false
# MEDIA_AUDIO_DEVICE=plughw:CARD=Microphone,DEV=0
# MEDIA_AUDIO_SAMPLE_RATE=48000
# MEDIA_AUDIO_BITRATE=96k
# MEDIA_AUDIO_SYNC_OFFSET_S=0.0

# --- door-sync (apps/door-sync/src/door_sync/settings.py) -------------------
DOOR_SYNC_BIND=127.0.0.1:8083
DOOR_SYNC_ADMIN_TOKEN=CHANGE_ME
CONTROL_PLANE_URL=http://nuc.local:8090
SYNC_INGEST_TOKEN=CHANGE_ME_INGEST_SCOPE_ONLY
SYNC_MEDIA_TARGET=nas
NAS_SYNC_TARGET=/mnt/nas/doorboard
SYNC_SYNCABLE_ROOTS=recordings,thumbnails

# door-sync tuning
# Queue poll cadence, retry backoff (base, ceiling), attempts before an item is
# parked as permanent, and how long completed rows are kept for the admin view.
# SYNC_POLL_INTERVAL_S=1.0
# SYNC_BACKOFF_BASE_S=2.0
# SYNC_BACKOFF_MAX_S=300
# SYNC_MAX_PERMANENT_ATTEMPTS=5
# SYNC_COMPLETED_RETENTION_S=86400

# --- ESP32 link + features ---------------------------------------------------
ESP32_TRANSPORT=uart
# Onboard bridge port of an ESP32-S3-DevKitC (not the Pi's own GPIO UART —
# the AI HAT+ occupies that header). See root .env.example and
# firmware/esp32-door-controller/README.md.
ESP32_UART_DEVICE=/dev/ttyACM1
FEATURE_PHOTOBOOTH=false

# --- Optional MQTT bridge (door-api, apps/door-api/src/door_api/config.py) --
# Subscribes to the NUC control-plane's Mosquitto and re-broadcasts
# NUC-produced ambient/presence events onto /ws so the wallboard tiles
# (aircraft/satellite/printer/birds/food + presence) actually receive data.
# EMPTY DOOR_API_MQTT_URL = disabled (default): no connection, no task, zero
# effect on the door path. Uncomment and point at the NUC broker (same host
# as CONTROL_PLANE_URL above) to enable; use a limited-scope Mosquitto
# account — the Pi never gets admin creds (ARCHITECTURE.md §Trust).
# e.g. mqtt://nuc.local:1883
# DOOR_API_MQTT_URL=
# limited-scope Mosquitto user (e.g. door-pi); NOT an admin account
# DOOR_API_MQTT_USERNAME=
# DOOR_API_MQTT_PASSWORD=
# DOOR_API_MQTT_TOPICS=doorboard/ambient/#,doorboard/status/#

# --- Spoken greeting (door-voice, ADR-0034; apps/door-voice/src/door_voice/settings.py) ---
# Off by default and opt-in PER PERSON: a speaker tells everyone in a shared
# corridor who is at this door, a louder disclosure than the screen. The
# About screen must say so before this is enabled for anyone.
# master switch; false = door-voice stays silent
# FEATURE_VOICE_GREETING=false
# comma-separated person_ids consented to being named aloud (ALLOW list, not a deny list)
# VOICE_GREETING_ALLOW=
# local time window with no announcements; empty disables the window
# VOICE_GREETING_QUIET_HOURS=22:00-08:00
# seconds before the same person is announced again
# VOICE_GREETING_COOLDOWN_S=600
# door-api's /ws, Pi-local
# VOICE_DOOR_API_WS_URL=ws://127.0.0.1:8080/ws
# VOICE_GREETING_TEMPLATE=Hi {name}
# local TTS; falls back to espeak-ng if VOICE_PIPER_VOICE is unset
# VOICE_PIPER_BINARY=piper
# path to a piper voice model; empty uses espeak-ng instead
# VOICE_PIPER_VOICE=
# VOICE_ESPEAK_BINARY=espeak-ng
# VOICE_APLAY_BINARY=aplay
# e.g. plughw:1,0 for a USB dongle; empty uses the ALSA default
# VOICE_ALSA_DEVICE=
# a wedged synthesiser must not accumulate processes behind it
# VOICE_SPEAK_TIMEOUT_S=8
# first delay after a dropped door-api /ws connection
# VOICE_RECONNECT_DELAY_S=3
# ceiling the delay doubles up to while door-api stays down
# VOICE_RECONNECT_MAX_DELAY_S=30
