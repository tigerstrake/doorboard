# Secrets — never commit real env files
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
.vite/
coverage/

# Next.js / Vercel (enroll-web build output and local link state)
.next/
next-env.d.ts
.vercel/

# Playwright — snapshot baselines are committed, run artifacts are not
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Media and local data — active recordings never belong in git
*.mp4
*.mkv
*.h264
*.wav
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
tests/performance/results/

# Face/enrollment data — biometric data never belongs in git
enrollment-data/
embeddings/
*.hef.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Firmware build artifacts
firmware/**/build/
firmware/**/.pio/
firmware/**/sdkconfig.old
# Generated from sdkconfig.defaults by `idf.py set-target`; committing it would
# let a stale local config outrank the defaults that are reviewed.
firmware/**/sdkconfig
# Fetched by the component manager from the registry; dependencies.lock pins the
# versions and IS committed, so these are reproducible without being vendored.
firmware/**/managed_components/
