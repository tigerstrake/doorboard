#!/usr/bin/env bash
# doorboard-enrollment-unlock — ADR-0009 §6 (Option C).
#
# Fetch the LUKS passphrase from the NUC control-plane, open the encrypted
# enrollment volume, and mount it so door-visiond finds a dm-crypt-backed
# enrollment root.
#
# FAIL-CLOSED: on any error (NUC unreachable, bad token, missing container)
# the volume stays UNMOUNTED and this script exits non-zero. door-visiond then
# reports enrollment_locked (recognition disabled, DB in :memory:) while the
# door button, local UI, recording, and sync run unaffected. This is the
# accepted post-cold-boot degradation from ADR-0009 §6.
#
# The passphrase is held only in a shell variable and piped straight to
# cryptsetup — it is never written to disk.
set -euo pipefail

CONF="${ENROLLMENT_UNLOCK_ENV:-/etc/doorboard/enrollment-unlock.env}"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

CONTAINER="${ENROLLMENT_CONTAINER:?ENROLLMENT_CONTAINER unset (see enrollment-unlock.env)}"
MAPPER="${ENROLLMENT_MAPPER:-vision-enrollment}"
MOUNT="${ENROLLMENT_MOUNT:-/mnt/vision-enrollment}"
DATA_SUBDIR="${ENROLLMENT_DATA_SUBDIR:-doorboard}"
OWNER="${ENROLLMENT_OWNER:-doorboard:doorboard}"
KEY_URL="${ENROLLMENT_KEY_URL:?ENROLLMENT_KEY_URL unset (see enrollment-unlock.env)}"
TOKEN_FILE="${ENROLLMENT_KEY_TOKEN_FILE:-/etc/doorboard/enrollment-key.token}"
CURL_MAX_TIME="${ENROLLMENT_CURL_MAX_TIME:-10}"

log() { echo "doorboard-enrollment-unlock: $*" >&2; }

# Idempotent: nothing to do if it is already mounted.
if mountpoint -q "$MOUNT"; then
	log "already mounted at $MOUNT"
	exit 0
fi

[ -f "$CONTAINER" ] || {
	log "container $CONTAINER is missing — run scripts/create-enrollment-volume first"
	exit 1
}
[ -r "$TOKEN_FILE" ] || {
	log "release token file $TOKEN_FILE is unreadable"
	exit 1
}

token="$(cat "$TOKEN_FILE")"

# Fetch the passphrase. -f makes curl fail on HTTP >= 400; pipefail makes the
# whole pipeline fail if either curl or the JSON extraction fails.
pass="$(
	curl -fsS --max-time "$CURL_MAX_TIME" \
		-H "Authorization: Bearer ${token}" "$KEY_URL" |
		python3 -c 'import json,sys; print(json.load(sys.stdin)["key"])'
)" || {
	unset token
	log "key fetch failed (NUC unreachable or unauthorized) — staying locked"
	exit 1
}
unset token
[ -n "$pass" ] || {
	log "control-plane returned an empty passphrase — staying locked"
	exit 1
}

# Open the LUKS device (skip if a prior partial run already opened it), then
# mount. cryptsetup reads the passphrase from stdin; it never lands on disk.
if [ ! -e "/dev/mapper/${MAPPER}" ]; then
	printf '%s' "$pass" | cryptsetup luksOpen --key-file=- "$CONTAINER" "$MAPPER" || {
		unset pass
		log "luksOpen failed (wrong passphrase or corrupt container)"
		exit 1
	}
fi
unset pass

mkdir -p "$MOUNT"
mount "/dev/mapper/${MAPPER}" "$MOUNT"

# door-visiond's enrollment_root is a subdirectory of the mount; make sure it
# exists and is owned by the service account with tight permissions.
mkdir -p "${MOUNT}/${DATA_SUBDIR}"
chown "$OWNER" "${MOUNT}/${DATA_SUBDIR}"
chmod 0700 "${MOUNT}/${DATA_SUBDIR}"

log "unlocked + mounted at ${MOUNT} (enrollment root: ${MOUNT}/${DATA_SUBDIR})"
