#!/usr/bin/env bash
set -euo pipefail

# Same venv resolution as lint/test/typecheck (scripts/_uv-env): an explicit
# UV_PROJECT_ENVIRONMENT, else the active VIRTUAL_ENV, else <repo>/.venv. This
# used to default to ~/.venvs/doorboard alone, so the simulator ran from a
# different environment than every other script and CI.
# shellcheck source=_uv-env
. "$(dirname "${BASH_SOURCE[0]}")/_uv-env"

uv run python -m doorboard_simulator panel "$@"
