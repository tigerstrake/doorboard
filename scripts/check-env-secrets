#!/usr/bin/env python3
"""Audit a deployment .env for the traps this repo has actually hit.

Run it on the NUC (or anywhere with a real .env):

    scripts/check-env-secrets ~/doorboard/.env

Reports, and exits non-zero if anything is found:

1. **Duplicate keys.** Compose silently takes the *last* occurrence. The door's NUC had a dead
   `POSTGRES_PASSWORD=CHANGE_ME` sitting above the real secret — working only by ordering.
   Reorder or delete the lower line and the stack comes up on a password published in this
   repo, with nothing to indicate anything changed.

2. **Placeholder secrets.** `CHANGE_ME` and friends, still in place.

3. **Inline comments.** Compose's --env-file keeps everything after the `=`, so `KEY=  # note`
   makes the note the value. This has bitten twice: it poisoned FOOD_HALL_IDS,
   FOOD_MEAL_OVERRIDE and OPENAI_API_KEY, and later FOOD_PREFERENCES_PATH took the dining job
   down with `No such file or directory: '# optional JSON override...'`.

Reads only; never prints a secret's value.
"""

from __future__ import annotations

import collections
import pathlib
import re
import sys

PLACEHOLDERS = {"change_me", "changeme", "change-me", "placeholder", "todo", "xxx", "secret"}


def _compose_interpolated_keys(env_path: pathlib.Path) -> set[str]:
    """Keys the compose stack substitutes, looked up next to the .env being audited.

    Returns an empty set when no compose file is found, in which case the inline-comment check
    falls back to reporting everything — noisier, but never silently skipping the real ones.
    """
    for candidate in (
        env_path.parent / "infra/compose/docker-compose.yml",
        pathlib.Path(__file__).resolve().parents[1] / "infra/compose/docker-compose.yml",
    ):
        if candidate.is_file():
            return set(
                re.findall(r"^\s{6}[A-Z0-9_]+:\s*\$\{([A-Z0-9_]+)", candidate.read_text(), re.M)
            )
    return set()


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__)
        return 2
    path = pathlib.Path(argv[1]).expanduser()
    if not path.is_file():
        print(f"no such file: {path}")
        return 2

    lines = path.read_text().splitlines()
    assignments: list[tuple[int, str, str]] = []
    for number, line in enumerate(lines, start=1):
        match = re.match(r"^([A-Z0-9_]+)=(.*)$", line)
        if match:
            assignments.append((number, match.group(1), match.group(2)))

    problems = 0

    counts = collections.Counter(key for _n, key, _v in assignments)
    duplicates = {key for key, n in counts.items() if n > 1}
    if duplicates:
        print("DUPLICATE KEYS — compose uses the LAST occurrence, the earlier ones are dead:")
        for key in sorted(duplicates):
            where = [n for n, k, _v in assignments if k == key]
            print(f"  {key}: lines {where}  (line {where[-1]} wins)")
        problems += len(duplicates)

    placeholders = [
        (n, k) for n, k, v in assignments if v.strip().strip("\"'").lower() in PLACEHOLDERS
    ]
    # A template is *supposed* to say CHANGE_ME; that is the whole point of it. Only a real
    # deployment file failing on them is a finding, or this tool becomes something people run
    # once, see 6 expected errors, and never run again.
    is_template = path.name.endswith(".example") or path.name.endswith(".sample")
    if placeholders:
        label = (
            "PLACEHOLDER SECRETS (expected in a template, listed for reference):"
            if is_template
            else "PLACEHOLDER SECRETS still in place — this deployment is using values "
            "published in the repo:"
        )
        print(f"\n{label}")
        for number, key in placeholders:
            print(f"  line {number}: {key}")
        if not is_template:
            problems += len(placeholders)

    # Inline comments only matter for keys the *compose* stack interpolates. The door Pi
    # bash-sources its .env, where `#` really is a comment, so flagging those would bury the
    # handful that can actually break something under dozens that cannot.
    compose_keys = _compose_interpolated_keys(path)
    inline = [
        (n, k)
        for n, k, v in assignments
        if (re.search(r"[^#]\s+#", v) or v.lstrip().startswith("#"))
        and (not compose_keys or k in compose_keys)
    ]
    if inline:
        scope = "compose-consumed keys" if compose_keys else "keys (no compose file found)"
        print(f"\nINLINE COMMENTS on {scope} — the comment becomes part of the value:")
        for number, key in inline:
            print(f"  line {number}: {key}")
        problems += len(inline)

    if problems == 0:
        print(f"{path}: {len(assignments)} assignments, nothing to flag")
        return 0
    print(f"\n{problems} thing(s) to fix in {path}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
