#!/usr/bin/env python3
"""Bake a low-resolution world coastline into a TS module for the satellite globe.

The satellite panel was an az/el sky dome — the right picture for "where do I look", and the
wrong one for the owner's ask: a globe, with the tracked satellite pinging at its current
position and its ground track crossing campus. A globe needs coastlines or it is a circle.

Natural Earth 110m, simplified and delta-encoded, same as the campus streets. Baked rather
than fetched: the doorboard must work with the internet down (E-19).

    scripts/build-world-coastline [--from-cache PATH]

Natural Earth is public domain (https://www.naturalearthdata.com/about/terms-of-use/), so no
attribution is legally required; it is credited in the generated module anyway.
"""

from __future__ import annotations

import argparse
import json
import math
import pathlib
import subprocess
import sys

SOURCE = (
    "https://raw.githubusercontent.com/nvkelso/natural-earth-vector"
    "/master/geojson/ne_110m_coastline.geojson"
)
# Coarser than the campus map by design: a 110m coastline drawn onto a ~360 px globe cannot
# show detail finer than a degree or so anyway, and every retained point costs bundle size.
DEFAULT_TOLERANCE = 0.35
SCALE = 100  # hundredths of a degree — ~1.1 km, far below what this can render


def fetch() -> dict:
    out = subprocess.run(
        ["curl", "-sL", "--max-time", "60", SOURCE], capture_output=True, text=True, check=True
    )
    return json.loads(out.stdout)


def simplify(points: list[tuple[float, float]], tolerance: float) -> list[tuple[float, float]]:
    """Douglas-Peucker on lon/lat degrees."""
    if len(points) <= 2:
        return points
    start, end = points[0], points[-1]
    dx, dy = end[0] - start[0], end[1] - start[1]
    span = math.hypot(dx, dy)
    worst_index, worst = 0, -1.0
    for index in range(1, len(points) - 1):
        px, py = points[index]
        if span == 0:
            distance = math.hypot(px - start[0], py - start[1])
        else:
            distance = abs(dy * (start[0] - px) - dx * (start[1] - py)) / span
        if distance > worst:
            worst_index, worst = index, distance
    if worst <= tolerance:
        return [start, end]
    return simplify(points[: worst_index + 1], tolerance)[:-1] + simplify(
        points[worst_index:], tolerance
    )


def encode(points: list[tuple[float, float]]) -> list[int]:
    """Flat delta-encoded ints: lon0, lat0, dlon, dlat, … (lon first, matching GeoJSON)."""
    out: list[int] = []
    prev_x = prev_y = 0
    for index, (lon, lat) in enumerate(points):
        x, y = round(lon * SCALE), round(lat * SCALE)
        out.extend([x, y] if index == 0 else [x - prev_x, y - prev_y])
        prev_x, prev_y = x, y
    return out


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--from-cache", type=pathlib.Path, default=None)
    parser.add_argument(
        "--out",
        type=pathlib.Path,
        default=pathlib.Path("apps/door-ui/src/wallboard/worldCoastline.ts"),
    )
    parser.add_argument("--tolerance", type=float, default=DEFAULT_TOLERANCE)
    args = parser.parse_args()

    data = json.loads(args.from_cache.read_text()) if args.from_cache else fetch()
    lines: list[list[int]] = []
    dropped = 0
    for feature in data.get("features", []):
        geometry = feature.get("geometry") or {}
        if geometry.get("type") != "LineString":
            dropped += 1
            continue
        pts = [(float(x), float(y)) for x, y in geometry["coordinates"]]
        simplified = simplify(pts, args.tolerance)
        # A two-point stub is a rendering artefact at this scale, not a coastline.
        if len(simplified) >= 3:
            lines.append(encode(simplified))

    body = ",\n".join("  [" + ",".join(str(v) for v in line) + "]" for line in lines)
    total = sum(len(line) // 2 for line in lines)
    module = f'''/**
 * World coastline, Natural Earth 110m. GENERATED — do not edit by hand.
 *
 * Regenerate with `scripts/build-world-coastline`. Baked rather than fetched because the
 * doorboard has to work with the internet down (E-19).
 *
 * Delta-encoded integers in hundredths of a degree, **lon first** (matching GeoJSON order,
 * and unlike campusStreets.ts which is lat-first — they are different source formats and
 * pretending otherwise would be the kind of quiet mistake that plots the Pacific over Asia).
 *
 * {len(lines)} lines, {total} points. Natural Earth is public domain; credited regardless.
 */

export const COASTLINE_COORD_SCALE = {SCALE};

/** Each entry: lon0, lat0, dlon, dlat, … in hundredths of a degree. */
export const WORLD_COASTLINE: readonly (readonly number[])[] = [
{body}
];

export const COASTLINE_CREDIT = "Natural Earth";
'''
    args.out.write_text(module)
    print(f"wrote {args.out} ({args.out.stat().st_size // 1024} KB)")
    print(f"  {len(lines)} lines, {total} points (dropped {dropped} non-LineString features)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
