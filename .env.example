# Doorboard environment template.
# Copy to .env per host and fill in. NEVER commit real values.
# Per the trust model (ARCHITECTURE.md §Trust), the door Pi gets ONLY
# limited-scope credentials. NAS admin and Home Assistant admin secrets
# live on the NUC only.

# --- Shared ---
DOORBOARD_ENV=dev                # dev | pi-door | nuc
DOORBOARD_DOOR_ID=primary
# display boundary only; services use UTC internally
TZ=America/Los_Angeles

# --- Door Pi (limited credentials only) ---
DOOR_API_BIND=127.0.0.1:8080
DOOR_API_CORS_ORIGINS=  # extra comma-separated browser origins allowed by CORS (defaults keep http://127.0.0.1:5173 + http://localhost:5173); add http://door-pi.local:5173 to open /admin from a LAN laptop
DOOR_API_SYNC_BASE_URL=http://127.0.0.1:8083 # loopback: admin/private gallery projection
DOOR_API_SYNC_OUTBOX_MAX_ROWS=4096 # bounded durable queue for contract events awaiting door-sync
DOOR_API_SYNC_TIMEOUT_S=1
DOOR_API_SOCIAL_ADMIN_TOKEN=    # required bearer secret for local admin/gallery routes; empty closes them with 503
DOOR_API_VISITOR_TOKEN_SECRET=  # persistent HMAC secret; changing it invalidates issued visitor QR links
DOOR_API_MEDIA_OUTBOX_MAX_ROWS=4096 # bounded durable queue for door-api -> door-media transitions
DOOR_API_MEDIA_BASE_URL=http://127.0.0.1:8082 # door-api -> door-media (door-media listens on 8082)
# Optional MQTT bridge: subscribe to the NUC control-plane's Mosquitto and
# re-broadcast NUC-produced ambient/presence events onto /ws so the wallboard
# tiles (aircraft/satellite/printer/birds/food + presence) actually receive
# data. EMPTY = DISABLED (default): no connection, no task, zero effect on the
# door path. Point it at the NUC broker (same host as CONTROL_PLANE_URL) to
# enable, and use a limited-scope Mosquitto account — the Pi never gets admin
# creds (ARCHITECTURE.md §Trust).
DOOR_API_MQTT_URL=              # e.g. mqtt://nuc.local:1883 — empty disables the bridge
DOOR_API_MQTT_USERNAME=         # limited-scope Mosquitto user (e.g. door-pi); NOT an admin account
DOOR_API_MQTT_PASSWORD=
DOOR_API_MQTT_TOPICS=doorboard/ambient/#,doorboard/status/# # only NUC-produced ambient/presence; door-api already emits its own session/vision/social events locally
# The display half of the greeting path (T-311). Read by BOTH door-api, which
# requires it on POST /internal/events, and door-visiond, which presents it when
# forwarding `vision.identity_stable` over loopback. Empty on either side means a
# recognised face gets the door light and a silent screen: door-api closes the
# route with 503, door-visiond reports `event_forwarding: disabled` in /health.
DOOR_API_INTERNAL_EVENT_TOKEN=   # shared loopback secret; generate per device (e.g. openssl rand -hex 32)
DOOR_API_BASE_URL=http://127.0.0.1:8080 # door-visiond → door-api; Pi-local, never routed off the door
DOOR_VISIOND_BIND=127.0.0.1:8081
DOOR_MEDIA_BIND=127.0.0.1:8082
MEDIAMTX_API=http://127.0.0.1:9997
# NOTE: not read by any service yet. door-api declares `esp32_transport` and
# leaves `self.esp32_transport = None`; only tests and the simulator inject a
# transport. `Esp32ProtocolTransport.open_uart()` in packages/esp32-link is
# ready, but nothing calls it at startup, so changing these two lines has no
# effect on the running door until that wiring lands.
ESP32_TRANSPORT=uart             # uart | udp | mock
# On an ESP32-S3-DevKitC the link is the onboard bridge port (/dev/ttyACM1 on the
# door Pi), not a Pi GPIO UART — see firmware/esp32-door-controller/README.md.
ESP32_UART_DEVICE=/dev/ttyAMA0
VISION_MODE=mock                 # disabled | mock | single-camera | dual-camera | hardware
SINGLE_CAMERA_MODE=true
SSD_DATA_ROOT=/mnt/ssd/doorboard
DOOR_VISIOND_ADMIN_TOKEN=        # required bearer secret for admin routes; empty closes them with 503
VISIOND_CONSENT_STATEMENT_PATH=docs/policies/consent-statement.md # canonical text; missing/unreadable returns 503
# Hailo face pipeline (T-305) — only used in single-camera/dual-camera/hardware modes
VISIOND_DETECTOR_HEF_PATH=/mnt/ssd/doorboard/models/scrfd_2.5g.hef        # SCRFD 640x640 face detector HEF
VISIOND_RECOGNIZER_HEF_PATH=/mnt/ssd/doorboard/models/arcface_mobilefacenet.hef # ArcFace 112x112 512-d recognizer HEF
VISIOND_SNAPSHOT_URL=http://127.0.0.1:8082/snapshot                      # door-media still endpoint; door-visiond never opens the camera
VISIOND_SNAPSHOT_TIMEOUT_S=2.0                                           # HTTP timeout for the snapshot fetch

# Self-service enrollment from the doorpad (ADR-0019). A visitor taps "Enroll My
# Face", gets a QR, and enrols from their own phone with no admin involved --
# enrollment grants no access, only a greeting and a name. These two caps are the
# whole safety story, so tune them rather than removing the feature:
VISIOND_SELF_ENROLL_PER_HOUR=6      # invites a visitor may mint per hour; 0 disables self-service
VISIOND_SELF_ENROLL_MAX_ENROLLED=50 # people this door will ever know; beyond it, only the owner can add
DOOR_API_VISIOND_BASE_URL=http://127.0.0.1:8081 # door-api -> door-visiond, to forward the doorpad's request

# --- door-media Retention & Storage ---
DOOR_MEDIA_MIN_FREE_BYTES=4294967296          # Stop recording if free SSD space drops below 4 GiB
DOOR_MEDIA_ADMIN_TOKEN=                       # required bearer secret for recording/admin routes; empty closes them with 503
DOOR_MEDIA_SEGMENT_RETENTION_S=3600           # delete raw continuous-capture segments after one hour
DOOR_MEDIA_SEGMENT_CLEANUP_INTERVAL_S=60      # raw segment retention sweep interval
DOOR_MEDIA_MAX_ACTIVE_RECORDINGS=8            # refuse new windows instead of growing in-memory state without bound
DOOR_MEDIA_MAX_RECORDING_BYTES=51539607552     # Global maximum SSD space for recordings (48 GiB)
DOOR_MEDIA_BELL_CLIP_MAX_AGE_S=259200          # Bell clip age cap (3 days)
DOOR_MEDIA_BELL_CLIP_MAX_SIZE_BYTES=10737418240 # Bell clip total size cap (10 GiB)
DOOR_MEDIA_VIDEO_MESSAGE_MAX_AGE_S=1209600      # Video message age cap (14 days)
DOOR_MEDIA_VIDEO_MESSAGE_MAX_SIZE_BYTES=32212254720 # Video message total size cap (30 GiB)
DOOR_MEDIA_PHOTO_BOOTH_MAX_AGE_S=604800        # Photo booth age cap (7 days)
DOOR_MEDIA_PHOTO_BOOTH_MAX_SIZE_BYTES=8589934592 # Photo booth total size cap (8 GiB)
DOOR_MEDIA_PHOTO_REVIEW_TTL_S=300              # Unsaved review captures are temporary (5 minutes)
DOOR_MEDIA_PHOTO_REVIEW_MAX_PENDING=16         # Bound in-memory/on-disk photo review queue
MEDIAMTX_RTSP_PORT=8554                        # local RTSP port MediaMTX binds (127.0.0.1 only); single source for publisher + snapshot
DOOR_MEDIA_SNAPSHOT_TIMEOUT_S=3.0              # GET /snapshot: max seconds to grab one live JPEG frame before falling back to placeholder
DOOR_MEDIA_SNAPSHOT_JPEG_QUALITY=3             # GET /snapshot: ffmpeg -q:v (2 = best … 31 = worst)
SYNC_UPLOAD_TOKEN=               # limited-scope upload token issued by NUC — NOT a NAS admin credential
CONTROL_PLANE_URL=http://nuc.local:8090

# --- door-sync (Pi → NUC/NAS upload bridge, T-502; limited credentials only) ---
DOOR_SYNC_BIND=127.0.0.1:8083
SYNC_INGEST_TOKEN=               # ingest-scoped NUC token: event mirror + person-purge (ADR-0009). Revocable.
NAS_SYNC_TARGET=                 # filesystem path of the mounted NAS share (limited service account); prod SFTP is deploy/nas
SYNC_MEDIA_TARGET=nas            # nas | mock (mock = no share, dev only)
DOOR_MEDIA_URL=http://127.0.0.1:8082   # loopback: reconcile + license local deletion
SYNC_SYNCABLE_ROOTS=recordings,thumbnails   # allowlist; visiond/ (biometrics) excluded by omission
DOOR_SYNC_ADMIN_TOKEN=           # local admin token gating GET /queue; empty closes the route with 503

# --- NUC (trusted control plane) ---
CONTROL_PLANE_BIND=0.0.0.0:8090
# Used when running control-plane-api standalone (outside infra/compose).
# Inside infra/compose/docker-compose.yml, this is instead built from
# POSTGRES_PASSWORD below and the `postgres` service hostname — the two
# stay independent so a bare-metal/dev run and the compose stack can differ.
POSTGRES_DSN=postgresql+psycopg://doorboard:CHANGE_ME@localhost:5432/doorboard
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=            # long-lived token, scoped, NUC only
# shared bearer secret for /admin/* (stopgap; see packages/auth README)
CONTROL_PLANE_ADMIN_TOKEN=
# LUKS passphrase for the Pi's encrypted visiond/ volume (ADR-0009 §6). Lives on the NUC only; empty = key-release off
CONTROL_PLANE_ENROLLMENT_KEY=
# bearer token the door Pi presents to GET /status/keys/enrollment (dedicated, NOT the admin token)
CONTROL_PLANE_ENROLLMENT_KEY_TOKEN=
# NUC-issued ingest-only token; worker does not receive the admin token
WALLBOARD_WORKER_INGEST_TOKEN=
# e.g. https://ntfy.sh — empty disables owner notifications (dev/CI default)
NTFY_URL=
NTFY_TOPIC=
DOORBELL_NOTIFY_ENABLED=true     # immediate "someone's at the door" alert on every ring; false silences just this rule
# A picture of whoever rang, sent as a SECOND message once door-media has cut a
# thumbnail from the bell clip (ADR-0022) -- the text above never waits for it.
# Separate flag so you can keep the instant alert without a frame of every delivery
# driver on your phone. Needs CONTROL_PLANE_DOOR_API_* set, like video delivery.
RING_PHOTO_ENABLED=true
# Telegram video-message delivery (T-609 / ADR-0012). When a visitor SAVES a
# video message, the NUC pulls the clip from door-api and sends it to Telegram.
# Disabled unless the bot token + chat id(s) + door-api creds below are all set.
# from @BotFather; empty disables Telegram delivery. NUC only.
TELEGRAM_BOT_TOKEN=
# comma-separated chat id(s): you, your roommate, or a shared group
TELEGRAM_CHAT_IDS=
# TELEGRAM_API_BASE_URL=https://api.telegram.org   # override only for a self-hosted Bot API server
# TELEGRAM_MAX_VIDEO_BYTES=52428800                # 50 MB; above this a text pointer is sent instead
# NUC → door-api, to fetch the saved clip
CONTROL_PLANE_DOOR_API_BASE_URL=http://door-pi.local:8080
# door-api admin bearer (== DOOR_API_SOCIAL_ADMIN_TOKEN on the Pi)
CONTROL_PLANE_DOOR_API_ADMIN_TOKEN=

# How long the control plane waits before repeating the same owner notification, so a
# flapping condition cannot spam Telegram/ntfy.
CONTROL_PLANE_NOTIFY_COOLDOWN_S=3600
# How long door-sync may go quiet before the control plane calls the door's upload stalled.
CONTROL_PLANE_SYNC_STALL_ALERT_S=14400
# Per-recipient video-message routing (ADR-0014). Map recipient key -> Telegram
# chat id as comma-separated key:chatid; a blank chat id is a known recipient
# with no chat yet (message saved, not sent). A saved message with no chosen
# recipient still broadcasts to TELEGRAM_CHAT_IDS above.
# e.g. tiger:8397445760,adam:  (fill in chat ids)
VIDEO_MESSAGE_RECIPIENTS=tiger:,adam:
CONTROL_PLANE_PRESENCE_HISTORY_MAX_ROWS=500 # presence_history retention cap, per subject_id (T-504)
CONTROL_PLANE_PRESENCE_STALE_AFTER_S=1800   # wallboard staleness hint threshold for the cached presence bundle

# --- NUC: infra/compose (T-503) ---
# LAN_BIND_ADDR: which interface Compose publishes ports on. 0.0.0.0 (every
# interface) is fine for a single-NIC NUC; set to a specific address on a
# dual-homed box. Never port-forward these on the router (handoff §16).
LAN_BIND_ADDR=0.0.0.0
# sets the `postgres` container's password (see POSTGRES_DSN note above)
POSTGRES_PASSWORD=CHANGE_ME
# Mosquitto per-device credentials (infra/compose/mosquitto/). Usernames are
# fixed conventions written into acl.conf (control-plane-api, door-pi,
# home-assistant, ha-discovery, healthcheck) — only these passwords are
# secret. control-plane-api's own MQTT_USERNAME/MQTT_PASSWORD above are
# overridden by Compose to `control-plane-api` / MQTT_CP_PASSWORD; the door
# Pi's own .env (out of git) gets MQTT_PI_PASSWORD copied in only if/when it
# ever needs to publish directly (it doesn't yet — door-sync talks HTTP to
# control-plane-api).
MQTT_CP_PASSWORD=CHANGE_ME
MQTT_PI_PASSWORD=CHANGE_ME
MQTT_HA_PASSWORD=CHANGE_ME
MQTT_HA_DISCOVERY_PASSWORD=CHANGE_ME
MQTT_HEALTHCHECK_PASSWORD=CHANGE_ME
# Postgres backup job (infra/compose/backup/pg-backup.sh) — NAS_BACKUP_PATH
# is a host mount of the NAS backups share (deploy/nas/README.md), never a
# Docker volume, so dumps survive a volume wipe.
NAS_BACKUP_PATH=/mnt/nas/doorboard/backups
BACKUP_INTERVAL_S=86400
BACKUP_RETAIN_COUNT=14
# Optional internal HTTPS (infra/caddy/), off by default (`--profile https`).
# Must be a LAN-only hostname — never a publicly routable domain.
DOORBOARD_INTERNAL_DOMAIN=doorboard.internal

# --- Integrations (all optional, feature-flagged) ---
FEATURE_BIRDNET=false
FEATURE_SATELLITES=false
FEATURE_AIRCRAFT=false
# New-species bird alert (control-plane-api, T-612): get a message the first time
# a detected bird is NOT in BIRD_KNOWN_SPECIES. Delivered via ntfy/Telegram.
# Needs bird detections to reach the control plane (the birdnet adapter feed).
BIRD_NEW_SPECIES_ALERT=false
# 30 days; one alert per new species per window
BIRD_NEW_SPECIES_COOLDOWN_S=2592000
# Comma-separated "known" species (case-insensitive). Seeded with the common
# birds near 94305 so you're only pinged for something new/rarer. Edit to taste.
BIRD_KNOWN_SPECIES=House Finch,California Towhee,Chestnut-backed Chickadee,Anna's Hummingbird,Lesser Goldfinch,Oak Titmouse,Spotted Towhee,California Scrub-Jay,American Crow,Steller's Jay,Mourning Dove,Bushtit,Black Phoebe,Violet-green Swallow,White-breasted Nuthatch
FEATURE_PRINTER=false
FEATURE_FOOD=false
# NOTE: this one gates the BACKEND only (door-media's /photos/* endpoints and
# door-api's snapshot). door-ui reads a SEPARATE build-time VITE_FEATURE_PHOTOBOOTH
# (below), because vite only exposes VITE_-prefixed vars and only from
# apps/door-ui — it never sees this file. Flipping only one is a silent no-op:
# backend-only leaves the UI with no photo step, UI-only makes every capture 404.
# Set both.
FEATURE_PHOTOBOOTH=false

# --- Spoken greeting (door-voice, ADR-0034) ---------------------------------
# Saying a name ALOUD is a louder disclosure than showing it on a screen a foot
# away: a speaker tells everyone in a shared corridor who is at this door. So
# this is off by default and opt-in PER PERSON, and the About screen must say so
# before it is enabled for anyone.
# --- Class schedule -> at_class (control-plane-api, ADR-0036) ----------------
# Published .ics feeds, per subject: owner=https://...,roommate=https://...
# Empty (the default) means no calendar source; presence resolves from
# manual/Focus/geofence exactly as before.
#
# Any ICS URL works: Google's "Secret address in iCal format", an iCloud public
# link, a Canvas calendar feed, a university course export. Every event on the
# feed counts as a class, so point this at a calendar that only has classes.
#
# TREAT THESE AS CREDENTIALS. A secret-address feed is a bearer token in a URL —
# anyone holding it can read the whole calendar. They are never logged, not even
# on a fetch failure.
PRESENCE_CALENDAR_ICS_URLS=
PRESENCE_CALENDAR_REFRESH_S=900
PRESENCE_CALENDAR_TIMEOUT_S=10
FEATURE_VOICE_GREETING=false
# Comma-separated person_ids that consented to being named aloud. An ALLOW list,
# never a deny list — with a deny list, forgetting to add a newly enrolled person
# means announcing them by default.
VOICE_GREETING_ALLOW=
# Local time. Empty disables the window; a malformed value is a hard error rather
# than a door that announces visitors all night.
VOICE_GREETING_QUIET_HOURS=22:00-08:00
# Much longer than the visual greeting's 30s: re-showing a name is free,
# re-announcing it to a corridor is not.
VOICE_GREETING_COOLDOWN_S=600
VOICE_DOOR_API_WS_URL=ws://127.0.0.1:8080/ws
VOICE_GREETING_TEMPLATE=Hi {name}
# Synthesis is always local — a cloud TTS call would put a recognised person's
# name on a third party on every approach. piper needs a voice model path; with
# none set, door-voice falls back to espeak-ng.
VOICE_PIPER_BINARY=piper
VOICE_PIPER_VOICE=
VOICE_ESPEAK_BINARY=espeak-ng
VOICE_APLAY_BINARY=aplay
# e.g. plughw:1,0 for a USB dongle. Empty uses the ALSA default.
VOICE_ALSA_DEVICE=
VOICE_SPEAK_TIMEOUT_S=8
VOICE_RECONNECT_DELAY_S=3
# door-ui build-time settings. Production must keep mock ambient data off.
VITE_AMBIENT_MOCK=false
VITE_AIRCRAFT_ALERT_DISTANCE_KM=3   # on-screen wallboard banner only (NOT a phone push)
# Live bird collage shown in the wallboard birds tile (under the stats). Point
# this at a collage PNG served by your window bird-Pi — e.g. an AvianVisitors
# frame image (shoot.py output / frame.png). Empty = no collage shown.
VITE_BIRD_COLLAGE_URL=              # e.g. http://bird-pi.local:8080/frame.png
# Aircraft observer centre (wallboard-worker). Real setting names are
# AIRCRAFT_OBSERVER_LAT/LON — set them to the address you want tracked. This
# centres BOTH the dedicated page's (wide) box and the proximity push below.
AIRCRAFT_OBSERVER_LAT=37.4242       # e.g. 459 Lagunita Drive, Stanford (geocoded)
AIRCRAFT_OBSERVER_LON=-122.1708
# wide box for the page (~±44 km) — NOT the alert radius
AIRCRAFT_BBOX_HALF_SIZE_LAT=0.4
AIRCRAFT_BBOX_HALF_SIZE_LON=0.4
# Per-plane enrichment (wallboard-worker): pull registration, type, operator,
# route and a photo for the nearest few planes from adsbdb + planespotters (both
# free, no API key). Best-effort + cached; a total outage still emits the basic
# OpenSky summary. Disable to skip all external enrichment calls.
AIRCRAFT_ENRICHMENT_ENABLED=true
# how many nearest planes to enrich per poll
AIRCRAFT_ENRICHMENT_MAX=6
# Proximity push-notification (control-plane-api, T-610): notify when a plane is
# within this many MILES of the observer centre above. 0 disables. This is ONLY
# the alert; the page keeps its wide box. Delivered via whichever owner channel
# is configured below (ntfy and/or Telegram). Optional altitude ceiling skips
# high cruisers; the alert has its own short cooldown so overhead traffic can't spam.
AIRCRAFT_ALERT_RADIUS_MI=1.0
# 0 = any altitude; e.g. 15000 to only alert on low aircraft
AIRCRAFT_ALERT_MAX_ALTITUDE_FT=0
# min seconds between overhead alerts
AIRCRAFT_ALERT_COOLDOWN_S=600
BIRDNET_GO_URL=
# OpenSky OAuth2 client credentials (register an API client at opensky-network.org).
# Basic auth is no longer accepted; empty = anonymous (works but heavily throttled).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Satellite observer location (wallboard-worker) — NUC only, never shown publicly.
#
# These are the keys the compose stack actually reads; it maps them onto the worker's
# SATELLITES_OBSERVER_* settings (infra/compose/docker-compose.yml). Setting the
# SATELLITES_OBSERVER_* names here instead does nothing, and the default is 0,0 — a
# satellite panel that confidently tells you where to look, for an observer in the Gulf
# of Guinea. Set your real location.
#   OBSERVER_ALT_M is metres above sea level.
OBSERVER_LAT=37.4275
OBSERVER_LON=-122.1697
OBSERVER_ALT_M=30
# SATELLITES_WATCHLIST=ISS (ZARYA)      # comma-separated; defaults to the ISS
# SATELLITES_EPHEMERIS_DIR=/tmp/skyfield  # writable dir for de421.bsp (image bundles it here)
PRINTER_API_URL=

# Food recommendation (wallboard-worker daily job — NUC only, never on the door)
#   FOOD_PROVIDER: "mock" (default) or "stanford" for the real Stanford R&DE menus.
FOOD_PROVIDER=mock
FOOD_RECOMMENDATION_CACHE_PATH=/tmp/doorboard_food_recommendation_cache.json
WALLBOARD_FOOD_INTERVAL_S=86400
# optional comma-separated hall filter, e.g. Wilbur,Stern
FOOD_HALL_IDS=
# optional: breakfast/lunch/brunch/dinner (default: auto by LA time)
FOOD_MEAL_OVERRIDE=
# optional JSON override of the bundled dietary preferences
FOOD_PREFERENCES_PATH=
# opt-in LLM refinement; only used when OPENAI_API_KEY is set
FOOD_USE_AI=false
# secret — NUC only; leave blank to use deterministic scoring
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How long door-api keeps treating a recognised person as present (ADR-0020). The
# short window applies when nobody is touching anything, so a passer-by's name is not
# held; any doorpad use re-arms the long one. Both fail toward forgetting.
DOOR_API_IDENTITY_IDLE_TTL_S=12          # recognised, no interaction
DOOR_API_IDENTITY_INTERACTION_TTL_S=120  # re-armed by each doorpad action

# --- Visitor camera encode (T-314) ---
# Shipped defaults were 720p/2Mbps/baseline with no autofocus and no tuning file, on a
# NoIR sensor: soft and washed out. Measured on the door: 1080p/high costs ~90% of one
# core (of four) versus ~40% for the old settings. Drop the resolution first if the face
# path ever starves.
VISITOR_CAM_INDEX=0                       # which physical camera publishes the stream
DOOR_MEDIA_VIDEO_WIDTH=1920
DOOR_MEDIA_VIDEO_HEIGHT=1080
DOOR_MEDIA_VIDEO_FRAMERATE=25
DOOR_MEDIA_VIDEO_BITRATE_BPS=6000000
DOOR_MEDIA_VIDEO_H264_PROFILE=baseline    # main/high enable B-frames, which this publish pipeline cannot carry
DOOR_MEDIA_VIDEO_AUTOFOCUS_MODE=continuous
# MUST match the sensor: a NoIR camera on the default tuning renders washed out.
DOOR_MEDIA_CAMERA_TUNING_FILE=/usr/share/libcamera/ipa/rpi/pisp/imx708_noir.json

# How long door-visiond waits before retrying its camera backend after three
# consecutive frame failures dropped it to `disabled` (T-321). Frames come from
# door-media over HTTP, so the usual cause is that service restarting -- which used to
# stop recognition permanently on an otherwise healthy door.
VISIOND_BACKEND_RECOVERY_DELAY_S=30

# --- Recognition camera (ADR-0023) ---
# The second CSI camera, faces only. -1 = not present (the single-camera door), in which
# case /snapshot/recognition 404s rather than quietly serving the visitor camera.
# Set VISION_MODE=dual-camera to actually use it; the wide sensor frames the doorway and
# the narrow one does faces, because recognition wants pixels-on-face not coverage.
RECOGNITION_CAM_INDEX=-1
DOOR_MEDIA_RECOGNITION_WIDTH=1280
DOOR_MEDIA_RECOGNITION_HEIGHT=720
DOOR_MEDIA_RECOGNITION_FRAMERATE=10
DOOR_MEDIA_RECOGNITION_ROTATION=0        # 0 or 180; independent of the visitor camera
# MUST match the recognition sensor, which is a different NoIR variant to the visitor's.
DOOR_MEDIA_RECOGNITION_TUNING_FILE=/usr/share/libcamera/ipa/rpi/pisp/imx708_noir.json
VISIOND_RECOGNITION_SNAPSHOT_URL=http://127.0.0.1:8082/snapshot/recognition

# ── wallboard-worker cadences and provider knobs ─────────────────────────────
# All of these were read by the worker and never passed through the compose stack,
# so they sat here doing nothing. Comments go above the key: compose's --env-file
# keeps everything after the '=' , including a trailing comment.

# Floor between OpenSky requests, independent of the job cadence.
AIRCRAFT_POLL_COOLDOWN_SECONDS=30
# Drop detections below this confidence.
BIRDNET_CONFIDENCE_THRESHOLD=0.70
# Comma-separated species allow-list; empty means all.
BIRDNET_SPECIES_FILTER=
# OctoPrint API key. NUC only.
OCTOPRINT_API_KEY=
# Optional printer webcam stream shown on the printer tile.
PRINTER_CAMERA_STREAM_URL=
# Ignore passes that never get this far above the horizon (degrees).
SATELLITES_MIN_ELEVATION=10.0
# Cached TLEs, so a fetch outage does not lose the pass.
SATELLITES_TLE_CACHE_PATH=/tmp/satellite_tle_cache.txt
# Where orbital elements come from.
SATELLITES_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle
# How often to poll OpenSky. The default is fine WITH credentials; anonymous access
# allows only ~400 credits/day, so leave this at 300+ until OPENSKY_CLIENT_ID is set
# or every poll will answer 429 and the tile will have nothing true to show.
WALLBOARD_AIRCRAFT_INTERVAL_S=30.0
# How often to summarise BirdNET detections.
WALLBOARD_BIRD_INTERVAL_S=300.0
# How often to rebuild the bird collage.
WALLBOARD_COLLAGE_INTERVAL_S=86400.0
# How often to poll the printer.
WALLBOARD_PRINTER_INTERVAL_S=30.0
# How often to recompute the next visible pass.
WALLBOARD_SATELLITE_INTERVAL_S=3600.0
# Liveness file the container healthcheck touches.
WALLBOARD_WORKER_HEARTBEAT_PATH=/tmp/wallboard-worker-heartbeat

# Which aircraft feed to use: auto | opensky | adsbfi.
# "auto" is OpenSky when OPENSKY_CLIENT_ID is set and adsb.fi otherwise. Anonymous OpenSky
# allows only a few hundred requests per IP per day and answers 429 to everything after that,
# so an unconfigured door needs the keyless feed. Register an OpenSky API client to prefer it.
AIRCRAFT_PROVIDER=auto
# Search radius for the adsb.fi feed, in nautical miles.
AIRCRAFT_RADIUS_NM=50
