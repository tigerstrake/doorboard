# public-relay — the doorboard's public front door (ADR-0016, ADR-0017)
#
# Never commit real values. None of these can decrypt an enrollment bundle (E-9):
# the sealing private key lives on the door Pi's encrypted volume and is never
# published here. The visitor surface is plaintext by design — see ADR-0017 for
# why that is scope, not sloppiness.

# Per-service device tokens. Two separate credentials rather than one shared
# secret, so a stolen door-api token cannot collect enrollment ciphertext and a
# stolen door-visiond token cannot post visitor content (ADR-0017 E-17).
# Generate each with:
#   openssl rand -base64 36 | tr -d '\n' | tr '+/' '-_'

# door-visiond → enrollment routes. Must match VISIOND_RELAY_DEVICE_TOKEN.
RELAY_DEVICE_TOKEN=

# door-api → visitor routes. Must match DOOR_API_VISITOR_RELAY_DEVICE_TOKEN.
RELAY_VISITOR_DEVICE_TOKEN=

# Upstash Redis (ADR-0016 §5). The Vercel marketplace integration injects the
# KV_REST_API_* pair automatically; set the UPSTASH_* pair for a manual/local setup.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
