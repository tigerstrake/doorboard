# Local env files, and any leftover link state from the Vercel era (the relay moved to
# Cloudflare with ADR-0043) — machine-local, never committed.
.vercel
.env
.env.local
.env.*.local
.env*

# Vendor / agent material that tooling drops beside the app. Regenerable third-party
# content, not project source; ADR-0016/0017/0043 and the READMEs are the reference.
.agents/
.claude/
skills-lock.json

# Build artifacts and local Cloudflare state — regenerated by `next build` / `wrangler`,
# never committed (unlike the personal-site repo, Cloudflare Pages builds `out/` on deploy).
/.next/
/out/
.wrangler/

# The example file documents which variables are required (values empty) and is
# committed on purpose. This negation must stay LAST: some CLIs append `.env*` to
# whichever .gitignore they run beside, and for gitignore the last matching pattern
# wins. If .env.example ever stops being tracked, check whether something appended
# below this line.
!.env.example
