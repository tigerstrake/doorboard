# Vercel CLI link state and pulled env — machine-local, never committed.
.vercel
.env
.env.local
.env.*.local
.env*

# Vendor documentation installed by the Upstash marketplace integration
# (`vercel integration add`). Regenerable third-party material, not project
# source; ADR-0016/0017 and the READMEs are the reference for this app.
.agents/
.claude/
skills-lock.json

# Build artifacts and local Cloudflare state — regenerated by `next build` / `wrangler`,
# never committed (unlike the personal-site repo, Cloudflare Pages builds `out/` on deploy).
/.next/
/out/
.wrangler/

# The example file documents which variables are required (values empty) and is
# committed on purpose. This negation must stay LAST: `vercel link` and
# `vercel integration add` append `.env*` to whichever .gitignore they run
# beside, and for gitignore the last matching pattern wins. If a .env.example
# ever stops being tracked, check whether the CLI appended below this line.
!.env.example
