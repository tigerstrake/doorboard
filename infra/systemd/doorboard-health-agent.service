[Unit]
Description=Doorboard bounded local health check
After=door-api.service door-media.service door-visiond.service door-sync.service

[Service]
Type=oneshot
# Root (it restarts units), so: the system interpreter and a root-owned copy
# of the script (installed by deploy/pi-door/install-*), never a venv or a
# file in the checkout that the service user can write. The agent is stdlib.
ExecStart=/usr/bin/python3 /usr/local/lib/doorboard/doorboard-health-agent
Environment=PYTHONUNBUFFERED=1
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# The agent restarts a unit only after three *consecutive* failed probes, and it
# keeps that count in /run/doorboard/health-failures.json. Both halves of this are
# required for the count to survive:
#
#   RuntimeDirectory alone creates the directory but systemd deletes it when the
#   unit deactivates -- and this is a oneshot fired every 30s by the timer, so it
#   deactivates immediately. The counters were wiped between every probe, the
#   threshold could never be reached, and a genuinely hung service would have been
#   noticed and then forgotten forever.
RuntimeDirectory=doorboard
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/doorboard
