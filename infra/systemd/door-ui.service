[Unit]
Description=Doorboard built kiosk UI
After=local-fs.target
# No start-rate limit: a door unit that crash-loops keeps retrying (RestartSec
# paces it) instead of being parked in `failed` after five tries in 10 s. The
# health agent handles the hung-but-active case; this handles the dead one.
StartLimitIntervalSec=0

[Service]
Type=simple
User=doorboard
Group=doorboard
WorkingDirectory=/opt/doorboard
ExecStart=/opt/doorboard/.venv/bin/python /opt/doorboard/scripts/serve_door_ui.py --directory /opt/doorboard/apps/door-ui/dist --host 127.0.0.1 --port 5173
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
