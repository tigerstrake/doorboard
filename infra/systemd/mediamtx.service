[Unit]
Description=Doorboard MediaMTX
Requires=doorboard-storage-ready.service
After=doorboard-storage-ready.service
# No start-rate limit: a door unit that crash-loops keeps retrying (RestartSec
# paces it) instead of being parked in `failed` after five tries in 10 s. The
# health agent handles the hung-but-active case; this handles the dead one.
StartLimitIntervalSec=0

[Service]
Type=simple
User=doorboard
Group=doorboard
ExecStart=/usr/local/bin/mediamtx /etc/doorboard/mediamtx.yml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/mnt/ssd/doorboard

[Install]
WantedBy=multi-user.target
