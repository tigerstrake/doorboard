[Unit]
Description=Doorboard durable sync service
Requires=doorboard-storage-ready.service
Wants=door-media.service
After=doorboard-storage-ready.service door-media.service
# No start-rate limit: a door unit that crash-loops keeps retrying (RestartSec
# paces it) instead of being parked in `failed` after five tries in 10 s. The
# health agent handles the hung-but-active case; this handles the dead one.
StartLimitIntervalSec=0

[Service]
Type=simple
User=doorboard
Group=doorboard
WorkingDirectory=/opt/doorboard
EnvironmentFile=/etc/doorboard/doorboard.env
ExecStart=/opt/doorboard/.venv/bin/python -m door_sync
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/mnt/ssd/doorboard -/mnt/nas/doorboard

[Install]
WantedBy=multi-user.target
